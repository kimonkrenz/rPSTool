## Citation guidance; licence notices are in inst/COPYRIGHTS.

## Package metadata supplied by citation().
vers <- meta$Version
pkg_title <- paste0("rPSTool: ", sub("^rPSTool: ", "", meta$Title))

yr <- local({
  d <- if (!is.null(meta$Date) && !is.na(meta$Date)) {
    meta$Date
  } else {
    meta$Packaged
  }
  y <- if (length(d)) {
    regmatches(d[1L], regexpr("[0-9]{4}", d[1L]))
  } else {
    character()
  }
  if (length(y) == 1L && nzchar(y)) y else NA_character_
})
yr_txt <- if (is.na(yr)) "n.d." else yr

## Cite rPSTool.
bibentry(
  "Manual",
  key = "rPSTool",
  title = pkg_title,
  author = person("Kimon", "Krenz"),
  year = yr_txt,
  note = paste0("R package version ", vers),
  textVersion = paste0(
    "Krenz K (", yr_txt, "). ",
    pkg_title, ". R package version ", vers, "."
  ),
  header = "To cite the rPSTool R package:"
)


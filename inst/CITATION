## `meta` is supplied by citation() from the installed DESCRIPTION.
vers <- meta$Version
## The year comes from the package metadata, never from the current date: DESCRIPTION's Date field if present, otherwise the
## year of the build timestamp (Packaged); NA if neither is usable, in which case the year is left unspecified.
yr <- local({
  d <- if (!is.null(meta$Date) && !is.na(meta$Date)) meta$Date else meta$Packaged
  y <- if (length(d)) regmatches(d[1L], regexpr("[0-9]{4}", d[1L])) else character()
  if (length(y) == 1L && nzchar(y)) y else NA_character_
})
yr_txt <- if (is.na(yr)) "n.d." else yr

bibentry(
  "Manual",
  key = "rPSTool",
  title = paste0("rPSTool: ", sub("^rPSTool: ", "", meta$Title)),
  author = person("Kimon", "Krenz"),
  year = if (is.na(yr)) "n.d." else yr,
  note = paste0("R package version ", vers),
  textVersion = paste0(
    "Krenz K (", yr_txt, "). rPSTool: ", meta$Title, ". R package version ", vers, "."),
  header = "To cite the rPSTool R package:"
)

